# SentryMesh Guardian Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Model Paths
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BASE_CLASSIFIER_PATH=models/classifier.joblib
LABEL_MAPPING_PATH=models/label_mapping.json
TACTIC_MODEL_PATH=models/tactic_model.joblib
TACTIC_MAPPING_PATH=models/tactic_mapping.json

# Dataset Configuration
MEAJOR_TEXT_COLUMN=email_text
MEAJOR_LABEL_COLUMN=is_phishing

# Threat Intel & Verification Feeds (Optional API keys - Leave blank for local offline mode)
PHISHTANK_API_KEY=
PHISHTANK_CACHE_PATH=data/raw/phishtank.csv
GOOGLE_SAFE_BROWSING_KEY=

# Privacy & Security
REPORT_STORAGE_PATH=data/user_reports/
ENABLE_ANONYMOUS_REPORTING=true
MAX_TEXT_LENGTH=8000
